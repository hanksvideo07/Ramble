<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Ramble records what you say so it can turn it into notes, tasks, and reminders.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Ramble adds events you asked for out loud to your calendar.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Ramble adds reminders you asked for out loud to your reminders list.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Ramble shows a live transcript while you speak.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>processing</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The deployed server is HTTPS. This exception only matters when
		     RAMBLE_API_URL points the build at a local http:// server. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.ramble.Ramble</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ramble</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
