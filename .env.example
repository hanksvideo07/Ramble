# ---------------------------------------------------------------------------
# Ramble server configuration
# Copy to server/.env and fill in. Never commit the filled-in copy.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8798
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
# Matches docker-compose.yml (host port 5434 to avoid clashing with a local
# Postgres on 5432 and other projects on 5433).
DATABASE_URL=postgres://ramble:ramble@localhost:5434/ramble

# --- Auth -----------------------------------------------------------------
# Signing key for session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Object storage (S3-compatible; MinIO locally) ------------------------
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=ramble-audio
S3_ACCESS_KEY_ID=rambleminio
S3_SECRET_ACCESS_KEY=rambleminio
S3_FORCE_PATH_STYLE=true
# How long generated playback/upload URLs stay valid, in seconds.
S3_SIGNED_URL_TTL=3600

# --- Understanding + answering (OpenRouter) -------------------------------
# REQUIRED for real extraction. Without it the server falls back to the
# mock understanding provider and every ramble is tagged mocked=true.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Extraction decides whether something was a musing or an instruction, so it
# runs on a model picked for schema adherence and instruction-following.
# Alternatives worth trying: nvidia/nemotron-3-nano-30b-a3b (half the output
# cost), openai/gpt-oss-20b (cheapest capable), qwen/qwen3-30b-a3b-instruct-2507
UNDERSTANDING_MODEL=openai/gpt-5-nano

# Answering just summarizes retrieved excerpts, so it can run cheaper.
ANSWER_MODEL=nvidia/nemotron-3-nano-30b-a3b

# --- Transcription --------------------------------------------------------
# Provider: deepgram | openai | mock
#
# On iOS 26+ the phone transcribes on-device and uploads the transcript, so the
# server usually never transcribes at all. This is the fallback for a recording
# that arrives without one.
TRANSCRIPTION_PROVIDER=mock
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# --- Embeddings -----------------------------------------------------------
# Provider: device | openai | mock
#
# 'device' means the iPhone embeds text with Apple's NLContextualEmbedding and
# uploads the vectors; the server never calls an embedding API. Vectors only
# compare within one model, so DIMENSION and REVISION must match what the
# device produces or semantic search is refused rather than silently wrong.
#
# Changing DIMENSION requires a migration — see 0002_client_side_ai.sql.
EMBEDDING_PROVIDER=device
EMBEDDING_MODEL=apple.nl_contextual
EMBEDDING_DIMENSION=512
EMBEDDING_REVISION=1

# --- Integrations (all optional; unset = integration hidden in the app) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8798/v1/integrations/google/callback

# --- Webhooks -------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=
